# Environment used when running inside docker-compose (service hostnames).
APP_ENV=development
APP_NAME=Insurance Management Platform
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
DEMO_MODE_ENABLED=true
CHAT_WIDGET_ENABLED=true
GITHUB_REPO_URL="https://github.com/HSEshan/Insurance-Company-Platform"

DATABASE_URL=postgresql+asyncpg://insurance:insurance@postgres:5432/insurance_db
REDIS_URL=redis://redis:6379/0

SECRET_KEY=dev_secret_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=dev_encryption_change_me

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

PREMIUM_LAPSE_DAYS=30
ORPHAN_OBJECT_GRACE_MINUTES=60

MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@insureco.com
MAIL_FROM_NAME=InsureCo
EMAIL_NOTIFICATIONS_ENABLED=true

# MINIO_PUBLIC_ENDPOINT is what presigned URLs point at, so it must be the
# address the browser can reach — not the compose service name.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
PRESIGNED_URL_EXPIRY_MINUTES=15
MAX_UPLOAD_SIZE_MB=25
