# --- Application ---
APP_ENV=development
APP_NAME=Insurance Management Platform
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
DEMO_MODE_ENABLED=true
CHAT_WIDGET_ENABLED=true
GITHUB_REPO_URL=

# --- Database ---
# Inside docker-compose the host is "postgres"; for bare-metal use "localhost".
DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change_me_to_a_long_random_hex_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Any string; a 32-byte Fernet key is derived from it deterministically.
ENCRYPTION_KEY=change_me_to_a_random_secret

# --- Auth hardening ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Celery (optional overrides; defaults derive redis db 1 / db 2) ---
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
PREMIUM_LAPSE_DAYS=30
ORPHAN_OBJECT_GRACE_MINUTES=60

# --- Email (MailHog locally: http://localhost:8025) ---
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@insureco.com
MAIL_FROM_NAME=InsureCo
EMAIL_NOTIFICATIONS_ENABLED=true

# --- Object storage (MinIO) ---
# Inside docker-compose the host is "minio"; for bare-metal use "localhost".
MINIO_ENDPOINT=localhost:9000
# Baked into presigned URLs, so it must be reachable from the user's browser.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
PRESIGNED_URL_EXPIRY_MINUTES=15
MAX_UPLOAD_SIZE_MB=25
