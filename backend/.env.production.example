# Copy to backend/.env.production on the VPS and fill in real values.
# Never commit the real .env.production file.

APP_ENV=production
APP_NAME=Insurance Management Platform
LOG_LEVEL=INFO

# Public site origin (CORS). Must match the browser URL exactly (no trailing slash).
FRONTEND_URL=https://insurance.example.com

# Portfolio demo flags — leave true if you want one-click logins + chat on the live site.
DEMO_MODE_ENABLED=true
CHAT_WIDGET_ENABLED=true
GITHUB_REPO_URL=

DATABASE_URL=postgresql+asyncpg://insurance:CHANGE_ME_DB_PASSWORD@postgres:5432/insurance_db
REDIS_URL=redis://redis:6379/0

# Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

PREMIUM_LAPSE_DAYS=30
ORPHAN_OBJECT_GRACE_MINUTES=60

MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@insureco.com
MAIL_FROM_NAME=InsureCo
EMAIL_NOTIFICATIONS_ENABLED=true

# Internal Docker network hostname for server-side MinIO I/O.
MINIO_ENDPOINT=minio:9000
# Host the *browser* uses for presigned PUT/GET (Nginx TLS vhost). No https:// prefix.
MINIO_PUBLIC_ENDPOINT=files.insurance.example.com
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_USE_SSL=true
MINIO_REGION=us-east-1
PRESIGNED_URL_EXPIRY_MINUTES=15
MAX_UPLOAD_SIZE_MB=25
