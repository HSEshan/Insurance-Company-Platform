# Host Nginx for insurance.YOURDOMAIN (TLS + SPA routes + API + MinIO).
#
# Install on the VPS (Debian/Ubuntu):
#   sudo cp deploy/nginx/insureco.conf.example /etc/nginx/sites-available/insureco
#   # edit server_name + ssl paths, then:
#   sudo ln -sf /etc/nginx/sites-available/insureco /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Prerequisites:
#   - DNS A records for insurance.YOURDOMAIN and files.insurance.YOURDOMAIN → VPS IP
#   - Certbot certs for both names (see DEPLOY.md)
#   - docker compose -f docker-compose.prod.yml publishing:
#       127.0.0.1:8080 → SPA, 127.0.0.1:8000 → API, 127.0.0.1:9000 → MinIO

# ---- HTTP: ACME + redirect to HTTPS ----
server {
    listen 80;
    listen [::]:80;
    server_name insurance.YOURDOMAIN files.insurance.YOURDOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- App: SPA + API ----
upstream insureco_spa {
    server 127.0.0.1:8080;
    keepalive 8;
}

upstream insureco_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name insurance.YOURDOMAIN;

    ssl_certificate     /etc/letsencrypt/live/insurance.YOURDOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insurance.YOURDOMAIN/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;

    # Applied to /api/ as well (JSON + Swagger HTML). Do NOT put CSP here:
    # FastAPI's Swagger UI loads an inline bootstrap script + jsdelivr, so a
    # server-level script-src 'self' blanks /api/docs. CSP belongs on the SPA.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 2m;

    # FastAPI — /api/v1 JSON API, /api/docs Swagger, /api/openapi.json.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_pass http://insureco_api;
    }

    # React Router: /login, /dashboard, /policies/:id, etc. → index.html via SPA container.
    # add_header in a location replaces parent add_header, so repeat HSTS etc.
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://insureco_spa;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # Allow same-origin API + MinIO files host (presigned uploads/downloads).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://files.insurance.YOURDOMAIN; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    }
}

# ---- MinIO (presigned PUT/GET from the browser) ----
upstream insureco_minio {
    server 127.0.0.1:9000;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name files.insurance.YOURDOMAIN;

    ssl_certificate     /etc/letsencrypt/live/insurance.YOURDOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insurance.YOURDOMAIN/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;

    # Uploads can be larger than JSON API bodies.
    client_max_body_size 30m;

    ignore_invalid_headers off;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300;
        proxy_set_header Connection "";
        chunked_transfer_encoding off;
        proxy_pass http://insureco_minio;
    }
}
